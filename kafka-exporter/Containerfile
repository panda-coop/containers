# kafka_exporter on Red Hat UBI 10 micro, from the upstream release binary.
# VERSION and both SHA256 values change together. Upstream publishes no checksum file: the sha256
# values are GitHub's asset digests of the release archives (equal to the first download), and
# the build fails if a later download does not match.

# renovate: datasource=github-releases depName=danielqsj/kafka_exporter extractVersion=^v(?<version>.+)$
ARG VERSION=1.11.0
ARG SHA256_AMD64=6a14dd10709d627d7be29a4b98fae8bb888761c7da54410e72bef8cdaf906e86
ARG SHA256_ARM64=4f5f0341cd5345d863b3017eb9bc143f653c43a7b37cd2bc5a6a4b028ef61c45

ARG DOWNLOAD_IMAGE=registry.access.redhat.com/ubi10/ubi-minimal:10.2@sha256:ab67cd02caf8706e34a695a1432ebe965934f6128ec352a6c3f4048b43a4fb5e
ARG BASE_IMAGE=registry.access.redhat.com/ubi10/ubi-micro:10.2@sha256:1c105e547de5d9e0bc20d06ebabee73b20bc6bba994c50ae3e207684fd8bef2b

# Both bases are pinned by digest in the ARGs above, which hadolint cannot see.
# hadolint ignore=DL3006
FROM ${DOWNLOAD_IMAGE} AS download

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# tar and gzip track the digest-pinned base; pinning RPM versions would break on every UBI update.
# Only the UBI repositories are enabled: RHEL repositories a subscribed build host injects
# must not satisfy a dependency.
# hadolint ignore=DL3041
RUN repos=(--disablerepo='*' --enablerepo=ubi-10-baseos-rpms --enablerepo=ubi-10-appstream-rpms) \
    && microdnf -y install "${repos[@]}" --setopt=install_weak_deps=0 --nodocs tar gzip \
    && microdnf clean all

ARG VERSION
ARG SHA256_AMD64
ARG SHA256_ARM64
ARG TARGETARCH

WORKDIR /tmp/kafka_exporter
RUN case "${TARGETARCH}" in \
      amd64) sha256="${SHA256_AMD64}" ;; \
      arm64) sha256="${SHA256_ARM64}" ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && archive="kafka_exporter-${VERSION}.linux-${TARGETARCH}.tar.gz" \
    && curl -fsSLo "${archive}" "https://github.com/danielqsj/kafka_exporter/releases/download/v${VERSION}/${archive}" \
    && echo "${sha256}  ${archive}" | sha256sum -c - \
    && tar -xzf "${archive}" --strip-components=1 \
    && install -D -m 0755 kafka_exporter /out/bin/kafka_exporter \
    && install -D -m 0644 -t /out/licenses LICENSE

# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

ARG VERSION
ARG RELEASE
ARG REVISION
ARG CREATED
ARG BASE_IMAGE

COPY --from=download /out/bin/ /usr/bin/
COPY --from=download /out/licenses/ /licenses/kafka_exporter/
# ubi-micro has no CA bundle; the exporter needs one for TLS to brokers without --tls.ca-file.
# The bundle is the download stage's UBI ca-certificates, so it tracks the pinned base.
COPY --from=download /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

USER 65534:65534
EXPOSE 9308
ENTRYPOINT ["/usr/bin/kafka_exporter"]

# Our identity over the inherited UBI labels; com.redhat.* blanked. The base digest label is
# what the scheduled rebuild compares against the current UBI digest. DL3048: the inherited
# key com.redhat.license_terms has an underscore, and blanking it needs that exact key.
# hadolint ignore=DL3048
LABEL name="panda-coop/ubi10-kafka-exporter" \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="Kafka exporter for Prometheus on Red Hat UBI 10 micro" \
      description="kafka_exporter, Prometheus metrics for Kafka brokers, topics and consumer groups, on Red Hat UBI 10 micro. Upstream static release binary, checksum-verified, rebuilt on UBI updates." \
      io.k8s.display-name="Kafka exporter" \
      io.k8s.description="kafka_exporter, Kafka topic offsets and consumer group lag as Prometheus metrics, on Red Hat UBI 10 micro." \
      vendor="Panda Coop" \
      maintainer="Panda Coop" \
      url="https://github.com/panda-coop/containers/tree/main/kafka-exporter" \
      build-date="${CREATED}" \
      vcs-ref="${REVISION}" \
      vcs-type="git" \
      com.redhat.component="" \
      com.redhat.license_terms="" \
      org.opencontainers.image.title="ubi10-kafka-exporter" \
      org.opencontainers.image.description="kafka_exporter on Red Hat UBI 10 micro. Built from github.com/panda-coop/containers. Not affiliated with or supported by Red Hat or the upstream project." \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.source="https://github.com/panda-coop/containers" \
      org.opencontainers.image.url="https://quay.io/repository/panda-coop/ubi10-kafka-exporter" \
      org.opencontainers.image.vendor="Panda Coop" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"
