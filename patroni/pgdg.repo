# PGDG for EL 10, from pgdg-redhat-repo-latest.noarch.rpm (EL-10-x86_64), reduced to the two
# repositories the image needs: pgdg18 for the server, pgdg-common for Patroni and its PGDG-built
# Python dependencies. Packages and repository metadata are both signature-checked against
# PGDG-RPM-GPG-KEY-RHEL (fingerprint D4BF 08AE 67A0 B4C7 A1DB  CCD2 40BC A2B4 08B4 0D20).
[pgdg18]
name=PostgreSQL 18 for RHEL $releasever - $basearch
baseurl=https://download.postgresql.org/pub/repos/yum/18/redhat/rhel-$releasever-$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/PGDG-RPM-GPG-KEY-RHEL

[pgdg-common]
name=PostgreSQL common RPMs for RHEL $releasever - $basearch
baseurl=https://download.postgresql.org/pub/repos/yum/common/redhat/rhel-$releasever-$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/PGDG-RPM-GPG-KEY-RHEL
