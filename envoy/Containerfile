# Envoy on Red Hat UBI 10 minimal, from the upstream release binary.
# VERSION and both SHA256 values change together; the sha256 values come from the release's
# checksums.txt.asc, and the build fails if the download does not match. The binary links
# glibc and libstdc++ dynamically, hence ubi-minimal rather than ubi-micro.

# renovate: datasource=github-releases depName=envoyproxy/envoy extractVersion=^v(?<version>.+)$
ARG VERSION=1.40.2
ARG SHA256_AMD64=1d64506e25c1844f146162ddb2ece7010fa4e784faddb40a079021491f1f03cc
ARG SHA256_ARM64=b9d6d1e06dd5838a3506de9f4deebad3de9a2ce6cadb87cd76222ca286213baf

ARG DOWNLOAD_IMAGE=registry.access.redhat.com/ubi10/ubi-minimal:10.2@sha256:ab67cd02caf8706e34a695a1432ebe965934f6128ec352a6c3f4048b43a4fb5e
ARG BASE_IMAGE=registry.access.redhat.com/ubi10/ubi-minimal:10.2@sha256:ab67cd02caf8706e34a695a1432ebe965934f6128ec352a6c3f4048b43a4fb5e

# Both bases are pinned by digest in the ARGs above, which hadolint cannot see.
# hadolint ignore=DL3006
FROM ${DOWNLOAD_IMAGE} AS download

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG VERSION
ARG SHA256_AMD64
ARG SHA256_ARM64
ARG TARGETARCH

WORKDIR /tmp/envoy
RUN case "${TARGETARCH}" in \
      amd64) sha256="${SHA256_AMD64}"; arch=x86_64 ;; \
      arm64) sha256="${SHA256_ARM64}"; arch=aarch_64 ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && binary="envoy-${VERSION}-linux-${arch}" \
    && curl -fsSLo "${binary}" "https://github.com/envoyproxy/envoy/releases/download/v${VERSION}/${binary}" \
    && echo "${sha256}  ${binary}" | sha256sum -c - \
    && curl -fsSLO "https://raw.githubusercontent.com/envoyproxy/envoy/v${VERSION}/LICENSE" \
    && curl -fsSLO "https://raw.githubusercontent.com/envoyproxy/envoy/v${VERSION}/NOTICE" \
    && install -D -m 0755 "${binary}" /out/bin/envoy \
    && install -D -m 0644 -t /out/licenses LICENSE NOTICE

# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

ARG VERSION
ARG RELEASE
ARG REVISION
ARG CREATED
ARG BASE_IMAGE

COPY --from=download /out/bin/ /usr/local/bin/
COPY --from=download /out/licenses/ /licenses/envoy/

USER 65534:65534
EXPOSE 10000
ENTRYPOINT ["/usr/local/bin/envoy"]
CMD ["-c", "/etc/envoy/envoy.yaml"]

# Our identity over the inherited UBI labels; com.redhat.* blanked. The base digest label is
# what the scheduled rebuild compares against the current UBI digest. DL3048: the inherited
# key com.redhat.license_terms has an underscore, and blanking it needs that exact key.
# hadolint ignore=DL3048
LABEL name="panda-coop/ubi10-envoy" \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="Envoy proxy on Red Hat UBI 10 minimal" \
      description="Envoy proxy on Red Hat UBI 10 minimal. Upstream release binary, checksum-verified, rebuilt on UBI updates." \
      io.k8s.display-name="Envoy" \
      io.k8s.description="Envoy proxy on Red Hat UBI 10 minimal." \
      vendor="Panda Coop" \
      maintainer="Panda Coop" \
      url="https://github.com/panda-coop/containers/tree/main/envoy" \
      build-date="${CREATED}" \
      vcs-ref="${REVISION}" \
      vcs-type="git" \
      com.redhat.component="" \
      com.redhat.license_terms="" \
      org.opencontainers.image.title="ubi10-envoy" \
      org.opencontainers.image.description="Envoy proxy on Red Hat UBI 10 minimal. Built from github.com/panda-coop/containers. Not affiliated with or supported by Red Hat or the upstream project." \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.source="https://github.com/panda-coop/containers" \
      org.opencontainers.image.url="https://quay.io/repository/panda-coop/ubi10-envoy" \
      org.opencontainers.image.vendor="Panda Coop" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"
