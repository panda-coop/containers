# Grafana Loki on Red Hat UBI 10 micro, from the upstream release binary.
# VERSION and both SHA256 values change together; the sha256 values come from the release's
# SHA256SUMS, and the build fails if the download does not match.

# renovate: datasource=github-releases depName=grafana/loki extractVersion=^v(?<version>.+)$
ARG VERSION=3.7.8
ARG SHA256_AMD64=62aea42c9cba52cd1642b3666ab37019a0ce4c24ab50b07e85dccc8d812f7d61
ARG SHA256_ARM64=a874c10ffefe4d66c914b8aac8897159451d3026469598341aa03c76084697de

ARG DOWNLOAD_IMAGE=registry.access.redhat.com/ubi10/ubi-minimal:10.2@sha256:ab67cd02caf8706e34a695a1432ebe965934f6128ec352a6c3f4048b43a4fb5e
ARG BASE_IMAGE=registry.access.redhat.com/ubi10/ubi-micro:10.2@sha256:1c105e547de5d9e0bc20d06ebabee73b20bc6bba994c50ae3e207684fd8bef2b

# Both bases are pinned by digest in the ARGs above, which hadolint cannot see.
# hadolint ignore=DL3006
FROM ${DOWNLOAD_IMAGE} AS download

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# unzip and tzdata track the digest-pinned base; pinning RPM versions would break on every
# UBI update. tzdata and the base's CA bundle go into the image: ubi-micro has neither, and
# upstream's distroless image ships both (object storage is HTTPS).
# Only the UBI repositories are enabled: RHEL repositories a subscribed build host injects
# must not satisfy a dependency.
# hadolint ignore=DL3041
RUN repos=(--disablerepo='*' --enablerepo=ubi-10-baseos-rpms --enablerepo=ubi-10-appstream-rpms) \
    && microdnf -y install "${repos[@]}" --setopt=install_weak_deps=0 --nodocs unzip tzdata \
    && microdnf clean all

ARG VERSION
ARG SHA256_AMD64
ARG SHA256_ARM64
ARG TARGETARCH

# The release zip holds only the binary; LICENSE and LICENSING.md (which lists the Apache-2.0
# directories) come from the release tag.
WORKDIR /tmp/loki
RUN case "${TARGETARCH}" in \
      amd64) sha256="${SHA256_AMD64}" ;; \
      arm64) sha256="${SHA256_ARM64}" ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && archive="loki-linux-${TARGETARCH}.zip" \
    && curl -fsSLo "${archive}" "https://github.com/grafana/loki/releases/download/v${VERSION}/${archive}" \
    && echo "${sha256}  ${archive}" | sha256sum -c - \
    && unzip -q "${archive}" \
    && curl -fsSLO "https://raw.githubusercontent.com/grafana/loki/v${VERSION}/LICENSE" \
    && curl -fsSLO "https://raw.githubusercontent.com/grafana/loki/v${VERSION}/LICENSING.md" \
    && mkdir -p /out/bin /out/etc/loki /out/data/loki/rules /out/data/loki/rules-temp \
    && install -m 0755 "loki-linux-${TARGETARCH}" /out/bin/loki \
    && install -D -m 0644 -t /out/licenses LICENSE LICENSING.md \
    && install -D -m 0644 /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /out/system/etc/pki/tls/certs/ca-bundle.crt \
    && mkdir -p /out/system/usr/share \
    && cp -a /usr/share/zoneinfo /out/system/usr/share/

# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

ARG VERSION
ARG RELEASE
ARG REVISION
ARG CREATED
ARG BASE_IMAGE

COPY --from=download /out/bin/ /usr/bin/
COPY --from=download /out/licenses/ /licenses/loki/
COPY --from=download /out/system/ /
COPY --from=download --chown=10001:10001 /out/etc/ /etc/
COPY --from=download --chown=10001:10001 /out/data/ /

WORKDIR /
USER 10001:10001
EXPOSE 3100
ENTRYPOINT ["/usr/bin/loki"]
CMD ["-config.file=/etc/loki/local-config.yaml"]

# Our identity over the inherited UBI labels; com.redhat.* blanked. The base digest label is
# what the scheduled rebuild compares against the current UBI digest. AGPL-3.0: the source
# label points at the upstream tag the binary was built from. DL3048: the inherited key
# com.redhat.license_terms has an underscore, and blanking it needs that exact key.
# hadolint ignore=DL3048
LABEL name="panda-coop/ubi10-loki" \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="Grafana Loki on Red Hat UBI 10 micro" \
      description="Grafana Loki on Red Hat UBI 10 micro. Upstream release binary, checksum-verified, rebuilt on UBI updates. AGPL-3.0, source: upstream tag in the image labels." \
      io.k8s.display-name="Loki" \
      io.k8s.description="Grafana Loki log aggregation system on Red Hat UBI 10 micro." \
      vendor="Panda Coop" \
      maintainer="Panda Coop" \
      url="https://github.com/panda-coop/containers/tree/main/loki" \
      build-date="${CREATED}" \
      vcs-ref="${REVISION}" \
      vcs-type="git" \
      com.redhat.component="" \
      com.redhat.license_terms="" \
      org.opencontainers.image.title="ubi10-loki" \
      org.opencontainers.image.description="Grafana Loki on Red Hat UBI 10 micro. Built from github.com/panda-coop/containers. Not affiliated with or supported by Red Hat or the upstream project." \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.source="https://github.com/grafana/loki/tree/v${VERSION}" \
      org.opencontainers.image.url="https://quay.io/repository/panda-coop/ubi10-loki" \
      org.opencontainers.image.vendor="Panda Coop" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"
