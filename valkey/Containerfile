# Valkey on Red Hat UBI 10 minimal, built from the upstream release source.
# VERSION and SHA256 change together; the sha256 is the one valkey-io/valkey-hashes publishes for
# the release tarball, and the build fails if the download does not match.

# renovate: datasource=github-releases depName=valkey-io/valkey
ARG VERSION=9.1.3
ARG SHA256=184e34ed2d9b51879b682b5b15205e2b9d677c60280e3cb453be8f520d04e293

# One base for the build stage and the final image.
ARG BASE_IMAGE=registry.access.redhat.com/ubi10/ubi-minimal:10.2@sha256:ab67cd02caf8706e34a695a1432ebe965934f6128ec352a6c3f4048b43a4fb5e

# The base is pinned by digest in the ARG above, which hadolint cannot see.
# hadolint ignore=DL3006
FROM ${BASE_IMAGE} AS build

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# The toolchain tracks the digest-pinned base; pinning RPM versions would break on every UBI
# update. Only the UBI repositories are enabled, so RHEL repositories a subscribed build host
# injects cannot satisfy a dependency. openssl-devel is in UBI AppStream, so TLS is built in.
# hadolint ignore=DL3041
RUN repos=(--disablerepo='*' --enablerepo=ubi-10-baseos-rpms --enablerepo=ubi-10-appstream-rpms) \
    && microdnf -y install "${repos[@]}" --setopt=install_weak_deps=0 --nodocs \
      gcc make openssl-devel tar gzip \
    && microdnf clean all

ARG VERSION
ARG SHA256
ARG TARGETARCH

WORKDIR /tmp/valkey
# Protected mode is turned off in the source, as the upstream valkey/valkey image does: a
# container's port is published explicitly, and a config flag would replace the whole default
# configuration. jemalloc gets upstream's page-size flags (64 KiB pages on arm64).
RUN case "${TARGETARCH}" in \
      amd64) lg_page=12 ;; \
      arm64) lg_page=16 ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSLo valkey.tar.gz "https://github.com/valkey-io/valkey/archive/refs/tags/${VERSION}.tar.gz" \
    && echo "${SHA256}  valkey.tar.gz" | sha256sum -c - \
    && tar -xzf valkey.tar.gz --strip-components=1 \
    && sed -ri 's!^( *createBoolConfig[(]"protected-mode",.*, *)1( *,.*[)],)$!\10\2!' src/config.c \
    && grep -qE '^ *createBoolConfig[(]"protected-mode",.*, *0 *,.*[)],$' src/config.c \
    && make -j "$(nproc)" BUILD_TLS=yes \
      JEMALLOC_CONFIGURE_OPTS="--with-lg-page=${lg_page} --with-lg-hugepage=21" all \
    && make PREFIX=/out install \
    && mkdir -p /out/data \
    && chmod 0775 /out/data \
    && install -D -m 0644 -t /out/licenses COPYING

# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

ARG VERSION
ARG RELEASE
ARG REVISION
ARG CREATED
ARG BASE_IMAGE

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# tzdata, as upstream, for local-time log timestamps; openssl-libs is already in the base.
# hadolint ignore=DL3041
RUN repos=(--disablerepo='*' --enablerepo=ubi-10-baseos-rpms --enablerepo=ubi-10-appstream-rpms) \
    && microdnf -y install "${repos[@]}" --setopt=install_weak_deps=0 --nodocs \
      tzdata \
    && microdnf clean all

COPY --from=build /out/bin/ /usr/bin/
COPY --from=build /out/licenses/ /licenses/valkey/
COPY --from=build --chown=999:999 /out/data/ /data/

WORKDIR /data
USER 999:999
EXPOSE 6379
VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/valkey-server"]

# Our identity over the inherited UBI labels; com.redhat.* blanked. The base digest label is
# what the scheduled rebuild compares against the current UBI digest. DL3048: the inherited
# key com.redhat.license_terms has an underscore, and blanking it needs that exact key.
# hadolint ignore=DL3048
LABEL name="panda-coop/ubi10-valkey" \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="Valkey on Red Hat UBI 10 minimal" \
      description="Valkey on Red Hat UBI 10 minimal. Built from the upstream release source, checksum-verified, rebuilt on UBI updates." \
      io.k8s.display-name="Valkey" \
      io.k8s.description="Valkey in-memory key-value data store on Red Hat UBI 10 minimal." \
      vendor="Panda Coop" \
      maintainer="Panda Coop" \
      url="https://github.com/panda-coop/containers/tree/main/valkey" \
      build-date="${CREATED}" \
      vcs-ref="${REVISION}" \
      vcs-type="git" \
      com.redhat.component="" \
      com.redhat.license_terms="" \
      org.opencontainers.image.title="ubi10-valkey" \
      org.opencontainers.image.description="Valkey on Red Hat UBI 10 minimal. Built from github.com/panda-coop/containers. Not affiliated with or supported by Red Hat or the upstream project." \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.source="https://github.com/panda-coop/containers" \
      org.opencontainers.image.url="https://quay.io/repository/panda-coop/ubi10-valkey" \
      org.opencontainers.image.vendor="Panda Coop" \
      org.opencontainers.image.licenses="BSD-3-Clause" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"
