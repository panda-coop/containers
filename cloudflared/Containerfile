# cloudflared on Red Hat UBI 10 micro, from the upstream release binary.
# VERSION and both SHA256 values change together; the sha256 values are the ones upstream publishes
# in the release notes (and GitHub's asset digests), and the build fails if the download does not
# match. The release binary is the one Cloudflare's RPM packages, a static Go binary. The release
# carries no LICENSE: it comes from the release tag and is checked against SHA256_LICENSE (the
# Apache-2.0 text, which does not change between releases).

# renovate: datasource=github-releases depName=cloudflare/cloudflared
ARG VERSION=2026.10.7
ARG SHA256_AMD64=1f99fb518b83dec2ba8d870a7cc991d82a77e6196295a3d2754ba17ab9f91872
ARG SHA256_ARM64=3df43aedc9ff291d1735b5cb576cb97e0b157488796db2e32b28aecabb445775
ARG SHA256_LICENSE=58d1e17ffe5109a7ae296caafcadfdbe6a7d176f0bc4ab01e12a689b0499d8bd

ARG DOWNLOAD_IMAGE=registry.access.redhat.com/ubi10/ubi-minimal:10.2@sha256:ab67cd02caf8706e34a695a1432ebe965934f6128ec352a6c3f4048b43a4fb5e
ARG BASE_IMAGE=registry.access.redhat.com/ubi10/ubi-micro:10.2@sha256:1c105e547de5d9e0bc20d06ebabee73b20bc6bba994c50ae3e207684fd8bef2b

# Both bases are pinned by digest in the ARGs above, which hadolint cannot see.
# hadolint ignore=DL3006
FROM ${DOWNLOAD_IMAGE} AS download

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG VERSION
ARG SHA256_AMD64
ARG SHA256_ARM64
ARG SHA256_LICENSE
ARG TARGETARCH

# The binary is not an archive, so the download stage installs nothing: curl and the CA bundle
# are in ubi-minimal. The paths are the RPM's: /usr/bin/cloudflared, and the /usr/local/bin link
# its post-install script creates. ubi-micro has no CA bundle; the connector needs one for the TLS
# to Cloudflare's edge, so the download stage's UBI ca-certificates bundle goes in at the RHEL
# path, which tracks the pinned base.
WORKDIR /tmp/cloudflared
RUN case "${TARGETARCH}" in \
      amd64) sha256="${SHA256_AMD64}" ;; \
      arm64) sha256="${SHA256_ARM64}" ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && binary="cloudflared-linux-${TARGETARCH}" \
    && curl -fsSLo "${binary}" "https://github.com/cloudflare/cloudflared/releases/download/${VERSION}/${binary}" \
    && echo "${sha256}  ${binary}" | sha256sum -c - \
    && curl -fsSLO "https://raw.githubusercontent.com/cloudflare/cloudflared/${VERSION}/LICENSE" \
    && echo "${SHA256_LICENSE}  LICENSE" | sha256sum -c - \
    && install -D -m 0755 "${binary}" /out/system/usr/bin/cloudflared \
    && install -d -m 0755 /out/system/usr/local/bin \
    && ln -s /usr/bin/cloudflared /out/system/usr/local/bin/cloudflared \
    && install -D -m 0644 /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /out/system/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem \
    && install -d -m 0755 /out/system/etc/pki/tls/certs \
    && ln -s /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /out/system/etc/pki/tls/certs/ca-bundle.crt \
    && install -D -m 0644 -t /out/licenses LICENSE

# hadolint ignore=DL3006
FROM ${BASE_IMAGE}

ARG VERSION
ARG RELEASE
ARG REVISION
ARG CREATED
ARG BASE_IMAGE

COPY --from=download /out/system/ /
COPY --from=download /out/licenses/ /licenses/cloudflared/

# No self-update in a container: a new version is a new image. As upstream's image, an environment
# variable rather than a flag, so it holds when the command is overridden.
ENV NO_AUTOUPDATE=true

# 65532 as upstream's image (distroless nonroot): the connector keeps no state, and the same UID
# keeps securityContext and Quadlet settings written for upstream's image valid.
USER 65532:65532
ENTRYPOINT ["cloudflared"]
CMD ["version"]

# Our identity over the inherited UBI labels; com.redhat.* blanked. The base digest label is
# what the scheduled rebuild compares against the current UBI digest. DL3048: the inherited
# key com.redhat.license_terms has an underscore, and blanking it needs that exact key.
# hadolint ignore=DL3048
LABEL name="panda-coop/ubi10-cloudflared" \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="cloudflared on Red Hat UBI 10 micro" \
      description="cloudflared, the Cloudflare Tunnel connector, on Red Hat UBI 10 micro. Upstream static release binary, checksum-verified, rebuilt on UBI updates." \
      io.k8s.display-name="cloudflared" \
      io.k8s.description="cloudflared, the Cloudflare Tunnel connector: outbound-only tunnels from Cloudflare's edge to local services, on Red Hat UBI 10 micro." \
      vendor="Panda Coop" \
      maintainer="Panda Coop" \
      url="https://github.com/panda-coop/containers/tree/main/cloudflared" \
      build-date="${CREATED}" \
      vcs-ref="${REVISION}" \
      vcs-type="git" \
      com.redhat.component="" \
      com.redhat.license_terms="" \
      org.opencontainers.image.title="ubi10-cloudflared" \
      org.opencontainers.image.description="cloudflared on Red Hat UBI 10 micro. Built from github.com/panda-coop/containers. Not affiliated with or supported by Red Hat or the upstream project." \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.source="https://github.com/panda-coop/containers" \
      org.opencontainers.image.url="https://quay.io/repository/panda-coop/ubi10-cloudflared" \
      org.opencontainers.image.vendor="Panda Coop" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"
